# Auto detect text files and perform LF normalization
* text=auto
# Keep signed Yarki manifests byte-for-byte stable.
installer-manifest.json text eol=lf
mods-manifest.json text eol=lf
manifest/installer-manifest.json text eol=lf
manifest/mods-manifest.json text eol=lf
*.sig binary
# Mod resources are payload bytes, even when a file looks like text.
Hangars/** -text
manifest/version.txt text eol=lf
